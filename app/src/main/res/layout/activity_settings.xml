<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E14"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textColor="#00D4FF"
        android:textSize="18sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gemini API Key"
        android:textColor="#888888"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etApiKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="AIza..."
        android:textColor="#FFFFFF"
        android:textColorHint="#444444"
        android:background="#1A2030"
        android:padding="12dp"
        android:fontFamily="monospace"
        android:textSize="13sp"
        android:inputType="textVisiblePassword"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Get your free API Key at aistudio.google.com"
        android:textColor="#555555"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnSaveKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SAVE"
        android:textColor="#0A0E14"
        android:backgroundTint="#00D4FF"
        android:fontFamily="monospace" />

</LinearLayout>
