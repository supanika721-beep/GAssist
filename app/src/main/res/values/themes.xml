<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#7C6EE6</item>
        <item name="colorPrimaryVariant">#5B4FCE</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSurface">#1C1B2E</item>
        <item name="colorOnSurface">#E6E1F9</item>
        <item name="android:windowBackground">#12111F</item>
        <item name="android:statusBarColor">#12111F</item>
        <item name="android:navigationBarColor">#12111F</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.Settings" parent="AppTheme" />

    <!-- Dialog dark theme -->
    <style name="DialogTheme" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">#7C6EE6</item>
        <item name="colorSurface">#1C1B2E</item>
        <item name="colorOnSurface">#E6E1F9</item>
        <item name="android:textColorPrimary">#E6E1F9</item>
        <item name="android:textColorSecondary">#9B97B8</item>
        <item name="android:background">#1C1B2E</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogBtnPositive</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogBtnNegative</item>
    </style>

    <style name="DialogBtnPositive" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">#7C6EE6</item>
    </style>

    <style name="DialogBtnNegative" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">#E05555</item>
    </style>
</resources>