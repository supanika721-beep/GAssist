<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E14"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GAssist"
            android:textColor="#00D4FF"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙ Settings"
            android:textColor="#00D4FF"
            android:backgroundTint="#1A2030"
            android:fontFamily="monospace"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Log output -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#111820"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#00D4FF"
            android:textSize="12sp" />
    </ScrollView>

    <!-- Status -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="4dp"
        android:textColor="#888888"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:text="Status: Checking..." />

    <!-- Input row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <EditText
            android:id="@+id/etGoal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Enter task goal..."
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:background="#1A2030"
            android:padding="10dp"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:inputType="text"
            android:imeOptions="actionSend" />

        <Button
            android:id="@+id/btnRun"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="RUN"
            android:textColor="#0A0E14"
            android:backgroundTint="#00D4FF"
            android:fontFamily="monospace" />
    </LinearLayout>

    <Button
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="■ STOP"
        android:textColor="#0A0E14"
        android:backgroundTint="#FF4444"
        android:fontFamily="monospace"
        android:visibility="gone" />

</LinearLayout>